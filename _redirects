# SPA routes — serve index.html for client-side routing
/auth/*      /index.html 200
/dashboard   /dashboard/index.html 200
/dashboard/  /dashboard/index.html 200
/dashboard/* /index.html 200

# Unknown /people/{slug} profiles render client-side; prerendered people dirs win
/people/*    /index.html 200

# Static download-page aliases used by the Vite dev server
/auto              /download/auto              302
/auto/             /download/auto/             302
/arch-chooser      /download/arch-chooser      302
/arch-chooser/     /download/arch-chooser/     302
/installer-chooser /download/installer-chooser 302
/installer-chooser/ /download/installer-chooser/ 302
/extension         /download/extension         302
/extension/        /download/extension/        302

# Retired language manifest URLs — the supported API is the single catalog.
/language-catalog/* /language-catalog.json 302
/language-data/* https://cdn.kikan.net/mlearn/language-data/:splat 302

# Python runtime binaries — served from R2 via custom domain
/runtimes/* https://cdn.kikan.net/mlearn/runtimes/:splat 302

# Everything else → real 404 (triggers 404.html with noindex)
/*           /404.html 404
